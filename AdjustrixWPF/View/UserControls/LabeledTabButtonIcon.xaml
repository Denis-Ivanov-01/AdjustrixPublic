<UserControl x:Class="AdjustrixWPF.View.UserControls.LabeledTabButtonIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
      Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
      VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Border Width="{Binding Width, RelativeSource={RelativeSource AncestorType=Grid}}"
            Grid.Row="0">
            <Grid>
                <Button Content="{materialDesign:PackIcon Kind=VectorPolygonVariant, Size=40}"
                        Style="{StaticResource TabButton}"
                        Background="Transparent"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Panel.ZIndex="1"
                        Grid.Row="0"
                        Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1"
               Margin="2"
               TextAlignment="Center"
               Background="Transparent"
               Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="12"
               Foreground="{DynamicResource ForegroundBrush}"
               TextWrapping="Wrap"/>
    </Grid>
</UserControl>
