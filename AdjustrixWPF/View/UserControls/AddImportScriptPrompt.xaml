<Window x:Class="AdjustrixWPF.View.UserControls.AddImportScriptPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="AddImportScriptPrompt" Height="550" Width="800"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Border BorderBrush="{DynamicResource ForegroundBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       d:Text="Manage Project"
                       Text="{Binding LanguageViewModel.ProjectSettings}"
                       Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                       FontSize="16"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="20 0 0 0"/>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Border Margin="5" Height="70">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border BorderThickness="0 0 1 0"
                                BorderBrush="{DynamicResource ForegroundBrush}"
                                Width="302">
                            <TextBlock Margin="20 0 50 0"
                                       d:Text="Input Parameter Type"
                                       Text="{Binding LanguageViewModel.InputParameterType}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Opacity="0.7"/>
                        </Border>
                        <Border Margin="100 0 0 0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ForegroundBrush}"
                                Height="30">
                            <ComboBox Height="30"
                                      Width="150"
                                      ItemsSource="{Binding InputParameterTypes, Converter={StaticResource ScriptParameterConverter}, Mode=OneWay}"
                                      SelectedItem="{Binding SelectedParameterType, Converter={StaticResource ScriptParameterConverter}}"
                                      d:Text="Placeholder name"
                                      Style="{StaticResource ComboBox}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      x:Name="TypeComboBox"/>
                        </Border>
                    </StackPanel>
                </Border>
                <local:LabeledTextBoxRow d:LabelText="Script Name"
                                         LabelText="{Binding LanguageViewModel.Name}"
                                         TextBoxText="{Binding NewImportScript.Name, Mode=TwoWay}"
                                         ControlWidth="300"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.FileExtension}"
                                         TextBoxText="{Binding NewImportScript.FileExtension, Mode=TwoWay}"
                                         ControlWidth="300"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.Filter}"
                                         TextBoxText="{Binding NewImportScript.FileFilter, Mode=TwoWay}"
                                         ControlWidth="300"/>
                <Border Margin="5" Height="70">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border BorderThickness="0 0 1 0"
                BorderBrush="{DynamicResource ForegroundBrush}"
                Width="302">
                            <TextBlock Margin="20 0 50 0"
                       d:Text="Input Parameter Type"
                       Text="{Binding LanguageViewModel.ScriptFile}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Opacity="0.7"/>
                        </Border>
                        <Border Margin="135 0 60 0"
                BorderThickness="0"
                Height="30">
                            <Button Content="{materialDesign:PackIcon Kind=FileCodeOutline,Size=25}"
                                    Style="{StaticResource YesButton}"
                                    Margin="0 0 0 0"
                                    Command="{Binding OpenScriptFileDialog}"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        HorizontalAlignment="Center">
                <Button Style="{StaticResource YesButton}"
                        Content="{Binding LanguageViewModel.Save}"
                        FontSize="14"
                        d:Content="Save"
                        Height="40"
                        Width="100"
                        Margin="0 0 50 0"
                        Click="SaveClick"/>
                <Button Style="{StaticResource NoButton}"
                        Content="{Binding LanguageViewModel.Cancel}"
                        FontSize="14"
                        d:Content="Cancel"
                        Height="40"
                        Width="100"
                        Margin="50 0 0 0"
                        Click="CancelClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
