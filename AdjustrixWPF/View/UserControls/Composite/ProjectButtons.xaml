<UserControl x:Class="AdjustrixWPF.View.UserControls.Composite.ProjectButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls.Composite"
             xmlns:userControls="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Grid.Column="1" 
                                    Margin="5 0 0 0"
                                    BorderThickness="1 0 0 0"
                                    BorderBrush="{DynamicResource ForegroundBrush}">
        <StackPanel Orientation="Horizontal">
            <userControls:LabeledTabButton
                Content=".adjx"
                FontWeight="Bold"
                Label="{Binding LanguageViewModel.NewProject}"
                Height="100"
                Width="70"
                Margin="10 0 0 0"
                Command="{Binding ProjectViewModel.CreateProject}"/>
            <userControls:LabeledTabButtonIcon
                Icon="ContentSaveOutline"
                ContentSize="30"
                Label="{Binding LanguageViewModel.SaveProject}"
                Height="100"
                Width="70"
                Margin="10 0 0 0"
                IsEnabled="{Binding ProjectViewModel.HasUnsavedChanges}"
                Command="{Binding ProjectViewModel.SaveProject}"/>
            <userControls:LabeledTabButtonIcon
                Icon="FolderOpenOutline"
                ContentSize="30"
                Label="{Binding LanguageViewModel.OpenProject}"
                Height="100"
                Width="70"
                Margin="10 0 0 0"
                Command="{Binding ProjectViewModel.OpenProject}"/>
            <userControls:LabeledTabButtonIcon
                Icon="BriefcaseEditOutline"
                Label="{Binding LanguageViewModel.EditProject}"
                Height="100"
                Width="70"
                Margin="10 0 0 0"
                Command="{Binding ProjectViewModel.EditProject}"/>
        </StackPanel>
    </Border>
</UserControl>
