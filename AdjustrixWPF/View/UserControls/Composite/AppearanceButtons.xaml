<UserControl x:Class="AdjustrixWPF.View.UserControls.Composite.AppearanceButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls.Composite"
             xmlns:userControls="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Height="{Binding ElementName=TabPanelGrid, Path=ActualHeight}">
        <Grid.RowDefinitions>
            <RowDefinition Height="10*"/>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="AppearanceBlock"
                                    Style="{StaticResource TextBlockTabPanel}"
                                           Text="{Binding LanguageViewModel.Appearance, UpdateSourceTrigger=PropertyChanged}"
                                           Margin="0 0 0 3"/>
        <userControls:LabeledComboBox LabelText="{Binding LanguageViewModel.LanguageString}"
                                      ComboBoxItemsSource="{Binding LanguageViewModel.Languages, Converter={StaticResource LanguagesConverter}}"
                                      ComboBoxSelectedItem="{Binding LanguageViewModel.CurrentLanguage, Converter={StaticResource LanguagesConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Grid.Row="1"
                                      x:Name="LanguageBox"
                                      Background="Transparent"/>
        <userControls:LabeledComboBox LabelText="{Binding LanguageViewModel.ThemeString}"
                                                              ComboBoxItemsSource="{Binding Path=LanguageViewModel.Themes, Converter={StaticResource ThemesConverter}}"
                                                              ComboBoxSelectedItem="{Binding Path=LanguageViewModel.SelectedTheme, Converter={StaticResource ThemesConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Grid.Row="2"
                                                              x:Name="ThemeBox"/>
    </Grid>
</UserControl>
