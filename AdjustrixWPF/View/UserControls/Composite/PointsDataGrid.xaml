<UserControl x:Class="AdjustrixWPF.View.UserControls.Composite.PointsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls.Composite"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DataGrid ItemsSource="{Binding KnownBenchmarks}"
              Style="{StaticResource CustomDataGridStyle}"
              AlternationCount="2"
              AlternatingRowBackground="{DynamicResource HoveredBrush}">
        <DataGrid.Columns>
            <DataGridTextColumn Width="50"/>
            <DataGridTextColumn Width="*" MinWidth="150"
                            Binding="{Binding Number}">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DataContext.LanguageViewModel.Number, 
                        RelativeSource={RelativeSource AncestorType=DataGrid}}"
                               d:Text="Number"
                               Foreground="{DynamicResource ForegroundBrush}"/>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <DataGridTextColumn Width="*"
                                MinWidth="150"
                                Binding="{Binding Value, StringFormat=F3}">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock d:Text="Elevation"
                                   Foreground="{DynamicResource ForegroundBrush}">
                            <Run Text="{Binding DataContext.LanguageViewModel.Elevation, 
                                    RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"/>
                            <Run Text=" [m]"/>
                        </TextBlock>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <DataGridTemplateColumn Width="*" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{materialDesign:PackIcon Kind=PencilOutline,Size=25}"
                                    ToolTip="{Binding DataContext.LanguageViewModel.Edit,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.EditPoint,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
