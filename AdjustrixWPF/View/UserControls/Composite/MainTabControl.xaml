<UserControl x:Class="AdjustrixWPF.View.UserControls.Composite.MainTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls.Composite"
             xmlns:userControls="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="650">
    <TabControl Grid.Row="0"
                Width="{Binding ElementName=MainGrid, Path=ActualWidth}" 
                HorizontalAlignment="Left" 
                Grid.RowSpan="2" 
                Background="{DynamicResource BackgroundBrush}" 
                Style="{StaticResource TabControlStyle}"
                Margin="0 3 0 0">
        <TabItem Style="{StaticResource TabItemStyle}"
                 Width="50">
            <TabItem.Header>
                <TextBlock d:Text="Test"
                           Text="{Binding languageViewModel.File}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextAlignment="Center" 
                           Panel.ZIndex="1"/>
            </TabItem.Header>
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ForegroundBrush}"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                          Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          x:Name="TabPanelGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="230"/>
                        </Grid.ColumnDefinitions>
                        <local:AppearanceButtons
                            Margin="5 5 0 5"/>
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource ForegroundBrush}"
                                BorderThickness="0 0 1 0"
                                Margin="0 5 0 5">
                            <local:ProjectButtons Grid.Column="1"/>
                        </Border>
                    </Grid>
                </StackPanel>

            </Border>
            
        </TabItem>
        <TabItem Style="{StaticResource TabItemStyle}" Width="50">
            <TabItem.Header>
                <TextBlock d:Text="Test"
                           Text="{Binding languageViewModel.Data}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextAlignment="Center" 
                           Panel.ZIndex="1"/>
            </TabItem.Header>
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ForegroundBrush}"
                    Background="Transparent">
                
                <StackPanel Orientation="Horizontal">
                    <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                          Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource DefaultBorder}" Margin="2"
                                BorderThickness="0 0 1 0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource DefaultBorder}"
                                    BorderThickness="0 0 0 1"
                                    Margin="5 0 5 0">
                                    <TextBlock Grid.Row="0"
                                           Style="{StaticResource TextBlockTabPanel}"
                                           Text=""
                                           d:Text="Data loading"/>
                                </Border>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <userControls:LabeledTabButton Content=".xlsx"
                                                                   Height="100"
                                                                   Width="60"
                                                                   Label=""
                                                                   d:Label="Excel"
                                                                   Margin="10 0 0 0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                    </Grid>
                </StackPanel>
            </Border>
        </TabItem>
        <TabItem Style="{StaticResource TabItemStyle}" Width="80">
            <TabItem.Header>
                <TextBlock d:Text="Processing"
                           Text="{Binding languageViewModel.Processing}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Background="Transparent"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextAlignment="Center" 
                           Panel.ZIndex="1"/>
            </TabItem.Header>
            <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ForegroundBrush}"
                    Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="{Binding Width, RelativeSource={RelativeSource AncestorType=Window}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <userControls:LabeledTabButtonIcon Height="105"
                                                               Margin="20 0 0 0"
                                                               Width="70"
                                                               Label="Adjust"
                                                               Command="{Binding ProcessingViewModel.Adjust}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>
</UserControl>
