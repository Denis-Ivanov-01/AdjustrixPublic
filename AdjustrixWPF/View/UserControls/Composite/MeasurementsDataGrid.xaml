<UserControl x:Class="AdjustrixWPF.View.UserControls.Composite.MeasurementsDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls.Composite"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Custom Style for DataGridCheckBoxColumn -->
        <Style x:Key="DataGridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignSecondaryCheckBox}">
            <Setter Property="Background" Value="{DynamicResource ForegroundBrush}"/>
        </Style>
    </UserControl.Resources>

    <DataGrid  ItemsSource="{Binding LevelingMeasurements}"
               Style="{StaticResource CustomDataGridStyle}"
               AlternationCount="2"
               AlternatingRowBackground="{DynamicResource HoveredBrush}">
        <DataGrid.Resources>
            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                <Setter Property="Content" Value=""/>
            </Style>
        </DataGrid.Resources>
        <DataGrid.Columns>
            <DataGridTextColumn Width="50"/>
            <DataGridTextColumn Binding="{Binding FromPoint.Number}" 
                                Width="2*"
                                MinWidth="150">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DataContext.LanguageViewModel.FromPoint, 
                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                   d:Text="FromPoint"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding ToPoint.Number}" 
                                Width="2*"
                                MinWidth="150">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DataContext.LanguageViewModel.ToPoint,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   d:Text="ToPoint"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Length, StringFormat=F3}" 
                                Width="1*"
                                MinWidth="150">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DataContext.LanguageViewModel.Length, 
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                   d:Text="Length"
                                   Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text=" [m]"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{Binding Value, StringFormat=F3}" 
                                Width="1*"
                                MinWidth="70">
                <DataGridTextColumn.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DataContext.LanguageViewModel.Value, 
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       d:Text="Length"
                                       Foreground="{DynamicResource ForegroundBrush}"/>
                            <TextBlock Text=" [m]"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTextColumn.HeaderTemplate>
            </DataGridTextColumn>
            <!-- Checkbox Column with Custom Style -->
            <DataGridCheckBoxColumn Binding="{Binding IsEnabled}"
                                    Width="100"
                                    MinWidth="60"
                                    ElementStyle="{StaticResource DataGridCheckBoxStyle}"
                                    EditingElementStyle="{StaticResource DataGridCheckBoxStyle}">
                <DataGridCheckBoxColumn.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock d:Text="Enabled"
                                   Foreground="{DynamicResource ForegroundBrush}"
                                   Text="{Binding DataContext.LanguageViewModel.Enabled, 
                                     RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"/>
                    </DataTemplate>
                </DataGridCheckBoxColumn.HeaderTemplate>
            </DataGridCheckBoxColumn>
            <DataGridTemplateColumn Width="*" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{materialDesign:PackIcon Kind=ToggleSwitchOutline, Size=25}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    ToolTip="{Binding DataContext.LanguageViewModel.Toggle,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Command="{Binding DataContext.ToggleMeasurement,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{materialDesign:PackIcon Kind=PencilOutline,Size=25}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="5 0 0 0"
                                    ToolTip="{Binding DataContext.LanguageViewModel.Edit,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.EditMeasurement,
                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
        </DataGrid.Columns>
    </DataGrid>
</UserControl>
