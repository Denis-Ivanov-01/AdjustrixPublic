<UserControl x:Class="AdjustrixWPF.View.UserControls.LabeledTabButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="40">
    <Grid Height="{Binding Height, RelativeSource={RelativeSource AncestorType=UserControl}}"
          Width="{Binding Width, RelativeSource={RelativeSource AncestorType=UserControl}}"
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Border Width="{Binding Width, RelativeSource={RelativeSource AncestorType=Grid}}"
                Grid.Row="0">
            <Grid>
                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           FontSize="{Binding ContentSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Background="Transparent"
                           Panel.ZIndex="0"/>
                <Button Style="{StaticResource TabButton}"
                        Background="Transparent"
                        Panel.ZIndex="1"
                        Height="{Binding Height, RelativeSource={RelativeSource AncestorType=Border}}"
                        Grid.Row="0"
                        Command="{Binding Command, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1"
                   Margin="2"
                   TextAlignment="Center"
                   Background="Transparent"
                   Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="12"
                   Foreground="{DynamicResource ForegroundBrush}"
                   FontWeight="Normal"
                   TextWrapping="WrapWithOverflow"/>
    </Grid>
</UserControl>
