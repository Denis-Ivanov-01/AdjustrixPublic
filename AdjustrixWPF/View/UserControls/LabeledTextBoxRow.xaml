<UserControl x:Class="AdjustrixWPF.View.UserControls.LabeledTextBoxRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Margin="5" Height="70">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border BorderThickness="0 0 1 0"
                BorderBrush="{DynamicResource ForegroundBrush}"
                Width="{Binding ControlWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Margin="20 0 50 0"
                       d:Text="Project name"
                       Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Opacity="0.7"/>
            </Border>
            <TextBox d:Text="Placeholder name"
                     Text="{Binding TextBoxText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     Style="{StaticResource MaterialDesignFilledTextBox}"
                     FontSize="14"
                     Foreground="{DynamicResource ForegroundBrush}"
                     Padding="5"
                     Margin="100 0 0 0"
                     Height="30"
                     Width="150"
                     MaxWidth="150"/>
        </StackPanel>
    </Border>
</UserControl>
