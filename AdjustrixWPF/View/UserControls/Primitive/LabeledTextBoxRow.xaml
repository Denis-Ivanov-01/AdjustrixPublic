<UserControl x:Class="AdjustrixWPF.View.UserControls.LabeledTextBoxRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Validation.ErrorTemplate="{x:Null}">
    <Border Margin="5" Height="70">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border BorderThickness="0 0 1 0"
                    BorderBrush="{DynamicResource ForegroundBrush}"
                    Width="{Binding ControlWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Margin="20 0 50 0"
                           Text="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Opacity="0.7"/>
            </Border>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Pushes TextBox down when needed -->
                    <RowDefinition Height="Auto"/>
                    <!-- Error Message -->
                </Grid.RowDefinitions>

                <!-- TextBox - Moves up when error message is visible -->
                <TextBox Grid.Row="0"
                         Text="{Binding TextBoxText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True, NotifyOnValidationError=True}"
                         FontSize="14"
                         Foreground="{DynamicResource ForegroundBrush}"
                         Style="{StaticResource MaterialDesignFilledTextBox}"
                         Padding="5"
                         Margin="100 0 0 0"
                         Height="30"
                         Width="150"
                         MaxWidth="150"
                         VerticalAlignment="Center">
                </TextBox>

                <!-- Error Message - Appears Below TextBox -->
                <TextBlock Grid.Row="1"
                           Foreground="Red"
                           FontSize="12"
                           Margin="5 2 0 0"
                           MaxWidth="235"
                           HorizontalAlignment="Right"
                           Text="{Binding Path=(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Visibility="{Binding Path=(Validation.HasError), 
                                       RelativeSource={RelativeSource AncestorType=UserControl}, 
                                       Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
