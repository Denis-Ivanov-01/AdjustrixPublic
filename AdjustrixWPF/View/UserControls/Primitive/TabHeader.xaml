<UserControl x:Class="AdjustrixWPF.View.UserControls.TabHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40">
    <Border HorizontalAlignment="Center"
            Height="{Binding Height, RelativeSource={RelativeSource AncestorType=TabItem}}"
            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=TabItem}}"
            Panel.ZIndex="0"
            BorderThickness="0">
        <TextBlock d:Text="Test"
                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Background="Transparent" 
                   Foreground="{DynamicResource ForegroundBrush}"
                   TextAlignment="Center"
                   Panel.ZIndex="1"/>
    </Border>
</UserControl>
