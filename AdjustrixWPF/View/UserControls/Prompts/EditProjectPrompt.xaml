<Window x:Class="AdjustrixWPF.View.EditProjectPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
        mc:Ignorable="d"
        Title="EditProjectPrompt" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BackgroundBrush}">
    <Border BorderBrush="{DynamicResource ForegroundBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       d:Text="Manage Project"
                       Text="{Binding LanguageViewModel.ProjectSettings}"
                       Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                       FontSize="16"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="20 0 0 0"/>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.ProjectName}"
                                         TextBoxText="{Binding ProjectProperties.ProjectName, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.SiteName}"
                                         TextBoxText="{Binding ProjectProperties.SiteName, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.Client}"
                         TextBoxText="{Binding ProjectProperties.Client, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.Contractor}"
                         TextBoxText="{Binding ProjectProperties.Contractor, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        HorizontalAlignment="Center">
                <Button Style="{StaticResource YesButton}"
                        Content="{Binding LanguageViewModel.Save}"
                        FontSize="14"
                        d:Content="Save"
                        Height="40"
                        Width="100"
                        Margin="0 0 50 0"
                        Click="SaveClick"/>
                <Button Style="{StaticResource NoButton}"
                        Content="{Binding LanguageViewModel.Cancel}"
                        FontSize="14"
                        d:Content="Cancel"
                        Height="40"
                        Width="100"
                        Margin="50 0 0 0"
                        Click="CancelClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
