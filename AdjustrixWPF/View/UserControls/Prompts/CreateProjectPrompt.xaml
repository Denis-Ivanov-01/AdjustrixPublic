<Window x:Class="AdjustrixWPF.View.UserControls.CreateProjectPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
        mc:Ignorable="d"
        Title="ManageProjectPrompt" Height="550" Width="800"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">
    <Border BorderBrush="{DynamicResource ForegroundBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       d:Text="Manage Project"
                       Text="{Binding LanguageViewModel.ProjectSettings}"
                       Style="{StaticResource MaterialDesignHeadline2TextBlock}"
                       FontSize="16"
                       Foreground="{DynamicResource ForegroundBrush}"
                       VerticalAlignment="Center"
                       Margin="20 0 0 0"/>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Border Margin="5" Height="70">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border BorderThickness="0 0 1 0"
                                BorderBrush="{DynamicResource ForegroundBrush}"
                                Width="232">
                            <TextBlock Margin="20 0 50 0"
                                       d:Text="Network Type"
                                       Text="{Binding LanguageViewModel.NetworkType}"
                                       Foreground="{DynamicResource ForegroundBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Opacity="0.7"/>
                        </Border>
                        <Border Margin="100 0 0 0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ForegroundBrush}"
                                Height="35">
                            <ComboBox Height="35"
                                      Width="150"
                                      ItemsSource="{Binding ProjectTypes, Converter={StaticResource ProjectTypesConverter}}"
                                      SelectedItem="{Binding SelectedProjectType, Converter={StaticResource ProjectTypesConverter}}"
                                      d:Text="Placeholder name"
                                      Style="{StaticResource ComboBox}"
                                      Foreground="{DynamicResource ForegroundBrush}"
                                      x:Name="TypeComboBox"/>
                        </Border>
                    </StackPanel>
                </Border>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.ProjectName}"
                                         TextBoxText="{Binding ProjectProperties.ProjectName, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.SiteName}"
                                         TextBoxText="{Binding ProjectProperties.SiteName, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.Client}"
                                         TextBoxText="{Binding ProjectProperties.Client, Mode=TwoWay}"/>
                <local:LabeledTextBoxRow LabelText="{Binding LanguageViewModel.Contractor}"
                                         TextBoxText="{Binding ProjectProperties.Contractor, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        HorizontalAlignment="Center">
                <Button Style="{StaticResource YesButton}"
                        Content="{Binding LanguageViewModel.Save}"
                        FontSize="14"
                        d:Content="Save"
                        Height="40"
                        Width="100"
                        Margin="0 0 50 0"
                        Click="SaveClick"/>
                <Button Style="{StaticResource NoButton}"
                        Content="{Binding LanguageViewModel.Cancel}"
                        FontSize="14"
                        d:Content="Cancel"
                        Height="40"
                        Width="100"
                        Margin="50 0 0 0"
                        Click="CancelClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
