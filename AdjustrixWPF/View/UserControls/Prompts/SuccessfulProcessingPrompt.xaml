<Window x:Class="AdjustrixWPF.View.UserControls.SuccessfulProcessingPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AdjustrixWPF.View.UserControls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="SuccessfulProcessingPrompt"
        WindowStyle="None"
        Width="400"
        Height="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        BorderThickness="3"
        BorderBrush="{DynamicResource ForegroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="80*"/>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="70*"/>
        </Grid.RowDefinitions>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Foreground="{DynamicResource ForegroundBrush}" 
                       Text="{Binding LanguageViewModel.ProcessingSuccessful}"
                       d:Text="Adjustment successful"
                       Style="{StaticResource MaterialDesignHeadlineLargeTextBlock}"/>
        </Border>
        <materialDesign:PackIcon Grid.Row="1" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Center"
                                 Kind="CheckCircleOutline"
                                 Foreground="Green"
                                 Width="100"
                                 Height="100">
        </materialDesign:PackIcon>
        <Border Grid.Row="2" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <TextBlock Foreground="{DynamicResource ForegroundBrush}" 
                       d:Text="Do you want to reveal the result reports?"
                       Text="{Binding LanguageViewModel.RevealQuestion}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Style="{StaticResource MaterialDesignBodyLargeTextBlock}"/>
        </Border>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button Content="{Binding LanguageViewModel.Yes}"
                    d:Content="Yes"
                    Margin="0 0 25 0"
                    Click="YesButtonClick"
                    Style="{StaticResource YesButton}"/>
            <Button Content="{Binding LanguageViewModel.No}"
                    d:Content="No"
                    Style="{StaticResource NoButton}"
                    Margin="25 0 0 0"
                    Click="NoButtonClick"/>
        </StackPanel>
        
    </Grid>
</Window>
