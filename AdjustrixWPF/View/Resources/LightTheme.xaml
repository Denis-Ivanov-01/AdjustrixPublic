<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Selected">#948b94</Color>
    <Color x:Key="Hovered">#c2b6c2</Color>
    <Color x:Key="OutOfFocus">#d1c7d1</Color>
    <Color x:Key="BackgroundColor">#ede6ed</Color>
    <Color x:Key="ForegrondColor">#2b232b</Color>
    <SolidColorBrush x:Key="BackgroundBrush">White</SolidColorBrush>
    <SolidColorBrush x:Key="HoveredBrush">#c2b6c2</SolidColorBrush>
    <SolidColorBrush x:Key="SelectedBrush">#948b94</SolidColorBrush>
    <SolidColorBrush x:Key="TabBackgroundBrush">#c9c2cf</SolidColorBrush>
    <SolidColorBrush x:Key="DisabledBrush">Black</SolidColorBrush>
    <Brush x:Key="ForegroundBrush">black</Brush>
    <SolidColorBrush x:Key="TabHeaderBackground">DarkBlue</SolidColorBrush>
</ResourceDictionary>