<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Selected">#948b94</Color>
    <Color x:Key="Hovered">#c2b6c2</Color>
    <Color x:Key="OutOfFocus">#d1c7d1</Color>
    <Color x:Key="BackgroundColor">#efefef</Color>
    <Color x:Key="ForegrondColor">#2b232b</Color>
    <SolidColorBrush x:Key="BackgroundBrush">#efefef</SolidColorBrush>
