<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BackgroundBrush">#efefef</SolidColorBrush>
    <SolidColorBrush x:Key="HoveredBrush">#cfcbcf</SolidColorBrush>
    <SolidColorBrush x:Key="SelectedBrush">#948b94</SolidColorBrush>
    <SolidColorBrush x:Key="TabBackgroundBrush">#efefef</SolidColorBrush>
    <SolidColorBrush x:Key="DisabledBrush">Black</SolidColorBrush>
    <Brush x:Key="ForegroundBrush">black</Brush>
    <SolidColorBrush x:Key="TabHeaderBackground">#363336</SolidColorBrush>
    <SolidColorBrush x:Key="TabHeaderForeground">white</SolidColorBrush>
    <SolidColorBrush x:Key="DataGridBackground">#d5d5d5</SolidColorBrush>
</ResourceDictionary>