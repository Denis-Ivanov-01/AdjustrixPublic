<Application x:Class="AdjustrixWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdjustrixWPF"
             xmlns:viewModels="clr-namespace:AdjustrixWPF.ViewModel"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <viewModels:LanguagesConverter x:Key="LanguagesConverter"/>
            <viewModels:ThemeConverter x:Key="ThemesConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="View/Resources/DarkTheme.xaml"/>
                <ResourceDictionary Source="View/Styles/TitleBarButton.xaml"/>
                <ResourceDictionary Source="View/Styles/TabControl.xaml"/>
                <ResourceDictionary Source="View/Styles/ComboBox.xaml"/>
                <ResourceDictionary Source="View/Styles/TextBlock.xaml"/>
                <ResourceDictionary Source="View/Styles/Border.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
