<Application x:Class="AdjustrixWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdjustrixWPF"
             xmlns:converters="clr-namespace:AdjustrixWPF.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <converters:LanguagesConverter x:Key="LanguagesConverter"/>
            <converters:ThemeConverter x:Key="ThemesConverter"/>
            <converters:ProjectTypeConverter x:Key="ProjectTypesConverter"/>
            <converters:ScriptParameterConverter x:Key="ScriptParameterConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="LightBlue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="View/Resources/DarkTheme.xaml"/>
                <ResourceDictionary Source="View/Styles/TitleBarButton.xaml"/>
                <ResourceDictionary Source="View/Styles/TabControl.xaml"/>
                <ResourceDictionary Source="View/Styles/ComboBox.xaml"/>
                <ResourceDictionary Source="View/Styles/TextBlock.xaml"/>
                <ResourceDictionary Source="View/Styles/Border.xaml"/>
                <ResourceDictionary Source="View/Styles/TabButton.xaml"/>
                <ResourceDictionary Source="View/Styles/TextBox.xaml"/>
                <ResourceDictionary Source="View/Styles/DataGrid.xaml"/>
                <ResourceDictionary Source="View/Styles/Button.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
